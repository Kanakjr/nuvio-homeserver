# Runtime Environment Configuration for Nuvio Web & Sync Server

# Server Daemon Port
PORT=8787

# Data directory for persistent downloads state & synced user profiles
DATA_DIR=/data/users

# Stremio streaming server companion URL (internal Docker network)
STREMIO_INTERNAL_URL=http://stremio-streaming-server:11470

# Optional Self-Hosted Supabase Backend
SUPABASE_INTERNAL_URL=http://host.docker.internal:8008
SERVICE_ROLE_KEY=
ANON_KEY=

# Optional Cloudflare Zero Trust SSO Email Mapping (JSON string)
# Example: SSO_EMAIL_MAPPINGS={"admin@example.com":{"supabaseEmail":"admin@example.com","defaultProfileIndex":1,"defaultProfileName":"Admin"}}
SSO_EMAIL_MAPPINGS=

# Client Build Variables
VITE_TMDB_API_KEY=
VITE_AUTH_SIGNUP_URL=
